<% dummy_page_nav(title: "Config", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Geocoding stays off until the host sets a provider and key.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioLocation.configure do |config|
        config.geocoder = RecordingStudioLocation::Geocoder.from_rails_credentials
      end

      RecordingStudio::Location.geocoder
    CODE
  ) %>
</div>
