<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Formatting helpers, plus explicit geocode! and reverse!.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "display_name",
    subtitle: "location.display_name",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      location.display_name
      # "Fitzroy, Victoria, Australia"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "full_address",
    subtitle: "location.full_address",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      location.full_address
      # "12 Smith Street, Fitzroy VIC 3065, Australia"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "coordinates",
    subtitle: "location.coordinates",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      location.coordinates
      # [-37.798, 144.978]
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "geocode!",
    subtitle: "location.geocode!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      location.geocode!
      location.coordinates
      # [-37.798, 144.978]
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "reverse!",
    subtitle: "location.reverse!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      location.reverse!
      location.full_address
      # "12 Smith Street, Fitzroy VIC 3065, Australia"
    CODE
  ) %>
</div>
