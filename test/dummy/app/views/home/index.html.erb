<% dummy_page_nav(title: "Location", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Location",
    subtitle: "A Location recording under Studio Workspace.",
    variant: :h1
  ) %>

  <% if @location_recording %>
    <%= recording_studio_location_display(@location_recording.recordable) %>

    <p class="text-sm text-(--surface-muted-content-color)">
      Recording <%= @location_recording.id %> under
      <%= @root_recording.recordable.name %>.
    </p>

    <div class="flex flex-wrap gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Edit location",
        style: :primary,
        href: edit_location_path(@location_recording)
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "All locations",
        style: :secondary,
        href: locations_path
      ) %>
    </div>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <p class="text-sm leading-6">
          Studio Workspace does not have a location yet. Add one to see the form and the read-only display.
        </p>
      <% end %>
    <% end %>

    <%= render FlatPack::Button::Component.new(
      text: "Add a location",
      style: :primary,
      href: new_location_path,
      class: "self-start"
    ) %>
  <% end %>
</div>
