<% venue_name = @location.name.to_s.strip.presence %>
<% dummy_page_nav(
  title: @location.display_name,
  subtitle: (venue_name if venue_name && venue_name != @location.display_name),
  back_url: locations_path,
  back_label: "Locations",
  edit_url: edit_location_path(@recording)
) %>

<div class="flex w-full max-w-3xl flex-col gap-6">
  <%= recording_studio_location_display(@location, map: true) %>
</div>
