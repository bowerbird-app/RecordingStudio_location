<% location = form.object %>
<% show_title = local_assigns.fetch(:show_title, true) %>
<% show_location_type = local_assigns.fetch(:show_location_type, true) %>
<% show_icon = local_assigns.fetch(:show_icon, true) %>

<div class="grid gap-4">
  <%= render "recording_studio_location/locations/identity_fields",
        form: form,
        show_title: show_title,
        show_location_type: show_location_type,
        show_icon: show_icon %>

  <%= render FlatPack::TextInput::Component.new(
    name: form.field_name(:name),
    value: location.name,
    label: t("recording_studio.location.fields.name"),
    placeholder: t("recording_studio.location.fields.name_placeholder"),
    help_text: t("recording_studio.location.fields.name_help"),
    error: location.errors[:name].first
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: form.field_name(:address_line_1),
    value: location.address_line_1,
    label: t("recording_studio.location.fields.address_line_1"),
    placeholder: t("recording_studio.location.fields.address_line_1_placeholder"),
    error: location.errors[:address_line_1].first
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: form.field_name(:address_line_2),
    value: location.address_line_2,
    label: t("recording_studio.location.fields.address_line_2"),
    error: location.errors[:address_line_2].first
  ) %>

  <div class="grid gap-4 sm:grid-cols-3">
    <%= render FlatPack::TextInput::Component.new(
      name: form.field_name(:locality),
      value: location.locality,
      label: t("recording_studio.location.fields.locality"),
      placeholder: t("recording_studio.location.fields.locality_placeholder"),
      error: location.errors[:locality].first
    ) %>

    <%= render FlatPack::TextInput::Component.new(
      name: form.field_name(:region),
      value: location.region,
      label: t("recording_studio.location.fields.region"),
      placeholder: t("recording_studio.location.fields.region_placeholder"),
      error: location.errors[:region].first
    ) %>

    <%= render FlatPack::TextInput::Component.new(
      name: form.field_name(:postal_code),
      value: location.postal_code,
      label: t("recording_studio.location.fields.postal_code"),
      placeholder: t("recording_studio.location.fields.postal_code_placeholder"),
      error: location.errors[:postal_code].first
    ) %>
  </div>

  <%= render FlatPack::Select::Component.new(
    name: form.field_name(:country_code),
    options: [[t("recording_studio.location.fields.country_not_set"), ""]] + RecordingStudio::Location.country_options,
    value: location.country_code,
    label: t("recording_studio.location.fields.country"),
    placeholder: t("recording_studio.location.fields.country_placeholder"),
    searchable: true,
    error: location.errors[:country_code].first
  ) %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= render FlatPack::NumberInput::Component.new(
      name: form.field_name(:latitude),
      value: location.latitude,
      label: t("recording_studio.location.fields.latitude"),
      placeholder: t("recording_studio.location.fields.latitude_placeholder"),
      min: -90,
      max: 90,
      step: 0.0000001,
      help_text: t("recording_studio.location.fields.latitude_help"),
      error: location.errors[:latitude].first
    ) %>

    <%= render FlatPack::NumberInput::Component.new(
      name: form.field_name(:longitude),
      value: location.longitude,
      label: t("recording_studio.location.fields.longitude"),
      placeholder: t("recording_studio.location.fields.longitude_placeholder"),
      min: -180,
      max: 180,
      step: 0.0000001,
      help_text: t("recording_studio.location.fields.longitude_help"),
      error: location.errors[:longitude].first
    ) %>
  </div>
</div>
